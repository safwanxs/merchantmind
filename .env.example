# Copy this file to .env.local and replace placeholders with local credentials.
# Never commit .env.local or real credentials.
# Optional: Gemini API key. The deterministic provider is used when absent.
GEMINI_API_KEY=replace_with_gemini_key
# Required: Razorpay server key ID.
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
# Required: Razorpay server secret; keep server-only.
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
# Required: browser-safe Razorpay key ID, matching RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=replace_with_razorpay_key_id
# Required: separate HMAC secret, at least 32 characters.
APPROVAL_TOKEN_SECRET=replace_with_a_random_32_character_secret
# Optional locally; required on Vercel for durable state.
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-endpoint
# Optional locally; required with UPSTASH_REDIS_REST_URL on Vercel.
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_token

